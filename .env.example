# Copy to .env, fill in, then load before running:
#   set -a; . ./.env; set +a
# Every value below is a placeholder.

# Klaviyo
# File containing only your private API key (read scopes for profiles, events).
KLAVIYO_API_KEY_FILE=/path/to/secrets/klaviyo-api-key
# Comma-separated Klaviyo metric IDs to sync as event streams. Find them with
# the Klaviyo Metrics API (GET /api/metrics). Leave empty for profiles only.
KLAVIYO_EVENT_METRICS=<METRIC_ID_1>,<METRIC_ID_2>

# Snowflake connection (key-pair authentication)
SNOWFLAKE_ACCOUNT=<YOUR_ACCOUNT>
SNOWFLAKE_USER=<YOUR_SERVICE_USER>
SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/secrets/snowflake_rsa_key.p8
# Only if the private key is encrypted:
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=
# Optional: full JDBC URL instead of SNOWFLAKE_ACCOUNT
SNOWFLAKE_JDBC_URL=

# Snowflake objects
SNOWFLAKE_WAREHOUSE=<YOUR_WAREHOUSE>
SNOWFLAKE_DATABASE=RAW
SNOWFLAKE_SCHEMA=KLAVIYO
SNOWFLAKE_ROLE=KLAVIYO_PIPELINE_ROLE

# Optional tuning (defaults shown)
KLAVIYO_MAX_SECONDS=120
KLAVIYO_MAX_PAGES=50
KLAVIYO_PAGES_PER_COMMIT=100
KLAVIYO_MAX_NO_PROGRESS_HOURS=10
KLAVIYO_INITIAL_WATERMARK=2020-01-01T00:00:00Z
KLAVIYO_STATUS_DIR=./state

# Testing only: failpoints are allowed only when SNOWFLAKE_SCHEMA equals this
KLAVIYO_DEV_SCHEMA=KLAVIYO_SYNC_DEV
